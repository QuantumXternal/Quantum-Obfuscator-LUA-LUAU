{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "models": {
        "deepseek-v4.1-flash-free": {
          "limit": { "context": 1048576, "output": 384000 }
        },
        "glm-5.3-flash-free": {
          "limit": { "context": 1048576, "output": 256000 }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "allow"
    }
  }
}
