{
  "name": "quantum-obfuscator",
  "version": "3.2.0",
  "description": "Luau parser and obfuscator with full Luau support",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "quantum-obfuscator": "dist/cli/obfuscate.js",
    "quantum-obfuscate-reg": "dist/cli/reg-vm-obfuscate.js",
    "quantum-lex": "dist/cli/lex.js",
    "quantum-parse": "dist/cli/parse.js"
  },
  "files": [
    "dist/",
    "public/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc",
    "build:web": "esbuild web/studio.js --bundle --format=esm --outfile=public/assets/studio.js --minify --sourcemap",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lex": "npm run build:server && node dist/cli/lex.js",
    "parse": "npm run build:server && node dist/cli/parse.js",
    "obfuscate": "npm run build:server && node dist/cli/obfuscate.js",
    "start": "npm run build && node dist/server.js",
    "serve": "node dist/server.js"
  },
  "keywords": [
    "luau",
    "obfuscator",
    "parser",
    "roblox"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
